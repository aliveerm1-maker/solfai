    </measure>
    <measure number="5">
      <!-- Tempo change -->
      <direction placement="above">
        <direction-type><words>poco rit.</words></direction-type>
      </direction>
      <!-- Triplet eighth notes + dotted quarter + eighth = intentionally 3 beats to test warning -->
