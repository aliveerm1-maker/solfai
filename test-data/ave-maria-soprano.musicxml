        <lyric number="1"><syllabic>single</syllabic><text>ve</text></lyric>
        <lyric number="2"><syllabic>single</syllabic><text>cta</text></lyric>
      </note>
      <note>
        <pitch><step>G</step><octave>4</octave></pitch>
        <duration>4</duration><type>quarter</type>
        <lyric number="1"><syllabic>single</syllabic><text>Ma</text></lyric>
        <lyric number="2"><syllabic>single</syllabic><text>Ma</text></lyric>
      </note>
      <note>
        <pitch><step>A</step><octave>4</octave></pitch>
        <duration>4</duration><type>quarter</type>
        <lyric number="1"><syllabic>single</syllabic><text>ri</text></lyric>
        <lyric number="2"><syllabic>single</syllabic><text>ri</text></lyric>
      </note>
    </measure>
    <measure number="2">
      <!-- C5 half B4 quarter A4 quarter -->
      <note>
        <pitch><step>C</step><octave>5</octave></pitch>
        <duration>8</duration><type>half</type>
        <lyric number="1"><syllabic>single</syllabic><text>a</text></lyric>
      </note>
      <note>
        <pitch><step>B</step><octave>4</octave></pitch>
