# Gemini API key — create in Google Cloud Console with Vertex AI API enabled
GEMINI_API_KEY=your-google-cloud-api-key-here

# Google Cloud project ID that has Vertex AI API enabled
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Vertex AI region (us-central1, us-east1, europe-west1, asia-northeast1, etc.)
GOOGLE_CLOUD_LOCATION=us-central1

# Local dev port (Render sets this automatically)
PORT=3000
