# Gemini API key — create at https://aistudio.google.com/apikey
# This is a Google AI Studio key (starts with "AIza..."), used via the
# generativelanguage.googleapis.com endpoint with the x-goog-api-key header.
GEMINI_API_KEY=your-google-ai-studio-key-here

# Local dev port (Render sets this automatically)
PORT=3000
